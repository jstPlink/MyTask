<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Oggi: lista delle righe (riga_*), messaggio a lista vuota, pulsante + per la nota veloce. Il padding in basso della lista lascia spazio al pulsante. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="@drawable/widget_bg_c">

    <ListView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="64dp" />

    <TextView
        android:id="@+id/vuoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_vuoto"
        android:textColor="#65656E"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/nota"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="2dp"
        android:gravity="center"
        android:background="@drawable/piu_bg_c"
        android:contentDescription="@string/widget_scrivi"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />
</FrameLayout>
