<?xml version="1.0" encoding="utf-8"?>
<!-- Pallino 30 x 30 dp dell'interesse di una curiosità: fondo appena colorato e contorno nel colore del livello. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <size android:width="28dp" android:height="28dp" />
            <solid android:color="#336FCF9B" />
            <stroke android:width="1dp" android:color="#6FCF9B" />
        </shape>
    </item>
</layer-list>
