<?xml version="1.0" encoding="utf-8"?>
<!-- Riga della lista di oggi nel widget: etichetta di priorità (o pallino dell'interesse per le curiosità) in "rank", titolo con la stima sotto, tempo già lavorato e checkbox. Colori di testo di base; il resto lo imposta WidgetService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riga"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="7dp"
    android:paddingEnd="4dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/rankbox"
        android:layout_width="59dp"
        android:layout_height="30dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rank_s"
            android:layout_width="22dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rank"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#404040"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#2F7D5B"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:fontFamily="monospace"
        android:textColor="#65656E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cb"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="4dp"
        android:contentDescription="@string/widget_spunta" />
</LinearLayout>
