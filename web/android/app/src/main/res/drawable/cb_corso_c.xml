<?xml version="1.0" encoding="utf-8"?>
<!-- Casella «in corso»: contorno giallo e metà sinistra piena, come nell'app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="22dp" android:height="22dp" />
            <stroke android:width="2dp" android:color="#D9A400" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:gravity="start" android:width="11dp" android:height="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#D9A400" />
            <corners android:topLeftRadius="7dp" android:bottomLeftRadius="7dp" />
        </shape>
    </item>
</layer-list>
