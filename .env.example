# Copia questo file in ".env" sul server e compila i valori. Il file .env non va mai caricato su GitHub.

# Credenziali dell'unico utente. Servono solo al primo avvio per creare l'account
# (la password viene salvata come hash). Dopo si possono togliere da questo file.
MYTASK_EMAIL=tu@example.com
MYTASK_PASSWORD=una-password-lunga-e-unica

# Porta sul NAS, quella a cui punta il tunnel Cloudflare (default 8787)
MYTASK_PORT=8787

# Facoltative (di solito non servono):
# CORS_ORIGINS=https://altro-sito.example   # altre origini web ammesse, oltre a quelle dell'app Android, separate da virgola
# BACKUP_DIR=/data/backups                   # dove il server salva la copia giornaliera del database (le ultime 14)

