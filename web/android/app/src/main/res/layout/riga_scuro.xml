<?xml version="1.0" encoding="utf-8"?>
<!-- Riga della lista di oggi nel widget: pallino della posizione (fermo in "rank", oppure "rank_flip" che alterna i quadri
     di rank_frame ogni 150 ms per il battito), titolo con orario sotto, checkbox. Colori di testo di base; il resto lo imposta WidgetService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riga"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="7dp"
    android:paddingEnd="4dp"
    android:paddingBottom="7dp">

    <FrameLayout
        android:id="@+id/rankbox"
        android:layout_width="26dp"
        android:layout_height="26dp">

        <TextView
            android:id="@+id/rank"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ViewFlipper
            android:id="@+id/rank_flip"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:autoStart="true"
            android:flipInterval="150"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F3F3F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#6FCF9B"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/cb"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="4dp"
        android:contentDescription="@string/widget_spunta" />
</LinearLayout>
